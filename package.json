{
  "name": "grantproof",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4317",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && npm run test:components",
    "test:components": "tsx --test components/Dashboard.test.tsx components/Modal.test.tsx components/RecoveryFlow.test.tsx",
    "test:e2e": "npm run build && playwright test",
    "demo:record": "npm run build && node scripts/record-demo.mjs",
    "demo:voiceover": "node scripts/add-voiceover.mjs",
    "reset": "tsx scripts/reset.ts",
    "qa:runtime": "node scripts/runtime-check.mjs",
    "qa:ui": "tsx --test tests/ui.test.tsx",
    "format": "prettier --write app lib scripts tests docs README.md *.json *.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
